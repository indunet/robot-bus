<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS: Shared Memory only (no UDPv4).
  segment_size must fit in container /dev/shm (Docker default often 64MiB).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_transport</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
      <maxMessageSize>65536</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="ros2_perf_shm" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
