# Build artifacts
target/
dist/
*.whl
*.egg-info/

# Node / Next.js (console/) — embed output is build-generated, not committed
node_modules/
.next/
console/out/
console/lib/bundled-docs.generated.ts
assets/console/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*

# Maturin / PyO3 native extension (built locally or in CI)
bindings/python/robot_bus/_native*.so
bindings/python/robot_bus/_native*.pyd
bindings/python/robot_bus/_native*.dll

# napi-rs native addon (built locally or in CI; published from artifacts)
bindings/typescript/*.node
bindings/typescript/index.d.ts
bindings/typescript/dist/
bindings/typescript/native/target/
bindings/typescript/native/Cargo.lock
# TS binding uses npm (package-lock.json); ignore accidental pnpm artifacts
bindings/typescript/pnpm-lock.yaml
bindings/typescript/pnpm-workspace.yaml

# C++ FFI / CMake build trees
bindings/cpp/native/target/
bindings/cpp/native/Cargo.lock
bindings/cpp/build/
bindings/cpp/build-*/
# Stray cmake probe output if cmake is run at the repo root (no root CMakeLists.txt).
/CMakeFiles/
/CMakeCache.txt

# Java (Maven) / Android (Gradle) / build trees
bindings/java/target/
bindings/java/local.properties
bindings/android/.gradle/
bindings/android/.kotlin/
bindings/android/build/
bindings/android/local.properties
bindings/android/.android-native-deps/
bindings/android/src/main/jniLibs/

# Library crate: dependents use their own lockfile
Cargo.lock

# IDE / OS
.idea/
.vscode/
.cursor/
.DS_Store

# Local env
.env
.env.*
.venv/
**/__pycache__/
*.py[cod]

# Local-only notes
dev_note.md

# Protobuf stubs — regenerate with `just gen-*` (CI / package builds); not tracked.
# Published wheels / crates / npm / DEB·MSI embed these after codegen.
src/generated/**
!src/generated/mod.rs
bindings/python/robot_bus/*/
!bindings/python/robot_bus/ros2_bridge/
!bindings/python/robot_bus/ros2_bridge/**
# The un-ignore above would otherwise track bytecode under ros2_bridge/.
bindings/python/robot_bus/ros2_bridge/**/__pycache__/
bindings/python/robot_bus/ros2_bridge/**/*.py[cod]
bindings/cpp/generated/
bindings/typescript/generated/
bindings/java/generated/
bindings/android/generated/

# Example C++ build outputs
examples/build/

# Codegen helper crate
scripts/gen_rust_msgs/target/
scripts/gen_rust_msgs/Cargo.lock

# ROS 2 perf local colcon workspace + merge partials (`run.sh --local`)
benches/ros2_perf/_ws/
benches/ros2_perf/_out.*.partial.md
