# Single source for protobuf compiler and runtime pins.
# scripts/protobuf_versions.py and scripts/install_protobuf_cpp.sh read this file.
# .github/actions/install-protoc reads it too.

# Prebuilt C++ packages, and Rust / TypeScript codegen. The C++ runtime bundled
# in those packages is this same release.
CPP_PROTOC=35.1

# Python, Java, and Android codegen. Measured 2026-11-28: stubs from protoc 29.3
# load on Python 5.29.3, 6.33.6, and 7.36.2, and on protobuf-java 4.29.3, 4.33.6,
# and 4.36.2. A newer compiler would raise the runtime floor.
GENCODE_PROTOC=29.3

PYTHON_PROTOBUF_FLOOR=5.29.3
PYTHON_PROTOBUF_LATEST_6=6.33.6
PYTHON_PROTOBUF_LATEST_7=7.36.2

JAVA_PROTOBUF_FLOOR=4.29.3
JAVA_PROTOBUF_LATEST_6=4.33.6
JAVA_PROTOBUF_LATEST_7=4.36.2
