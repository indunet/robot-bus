@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# configure_package_config_file fills in the init line above. It sets
# PACKAGE_PREFIX_DIR from this file's location
# (<prefix>/lib/cmake/robot_bus/). The fallback covers a raw template.
if(NOT DEFINED PACKAGE_PREFIX_DIR OR PACKAGE_PREFIX_DIR STREQUAL "")
  get_filename_component(PACKAGE_PREFIX_DIR "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
endif()
set(_robot_bus_package_prefix "${PACKAGE_PREFIX_DIR}")
set(_robot_bus_saved_prefix_path "${CMAKE_PREFIX_PATH}")

# Prefer Protobuf shipped inside this prefix (SDK archive). Installer packages
# do not carry Protobuf's CMake config, so they keep the normal search order.
set(_robot_bus_bundled_protobuf FALSE)
foreach(_robot_bus_pb_config IN ITEMS
    "${PACKAGE_PREFIX_DIR}/lib/cmake/protobuf/protobuf-config.cmake"
    "${PACKAGE_PREFIX_DIR}/lib64/cmake/protobuf/protobuf-config.cmake")
  if(EXISTS "${_robot_bus_pb_config}")
    set(_robot_bus_bundled_protobuf TRUE)
    break()
  endif()
endforeach()
if(_robot_bus_bundled_protobuf)
  list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
  # Archives ship Release binaries only. Map other configs onto Release so
  # Debug builds of a consumer still link these imported targets. Scoped to
  # Windows, where a Debug CRT mismatch is the failure mode.
  if(WIN32)
    if(NOT DEFINED CMAKE_MAP_IMPORTED_CONFIG_DEBUG)
      set(CMAKE_MAP_IMPORTED_CONFIG_DEBUG Release)
    endif()
    if(NOT DEFINED CMAKE_MAP_IMPORTED_CONFIG_RELWITHDEBINFO)
      set(CMAKE_MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release)
    endif()
    if(NOT DEFINED CMAKE_MAP_IMPORTED_CONFIG_MINSIZEREL)
      set(CMAKE_MAP_IMPORTED_CONFIG_MINSIZEREL Release)
    endif()
  endif()
endif()

find_dependency(Protobuf CONFIG REQUIRED)
set(PACKAGE_PREFIX_DIR "${_robot_bus_package_prefix}")

# Build @loader_path without writing that token in this file. configure_file
# would treat @loader_path as a substitution.
macro(_robot_bus_add_consumer_rpath _robot_bus_rpath_target)
  if(APPLE)
    string(CONCAT _robot_bus_rpath_origin "@" "loader_path")
    set_property(TARGET ${_robot_bus_rpath_target} APPEND PROPERTY
      INTERFACE_LINK_OPTIONS
        "LINKER:-rpath,${PACKAGE_PREFIX_DIR}/lib"
        "LINKER:-rpath,${_robot_bus_rpath_origin}")
  elseif(UNIX)
    set_property(TARGET ${_robot_bus_rpath_target} APPEND PROPERTY
      INTERFACE_LINK_OPTIONS
        "LINKER:-rpath,${PACKAGE_PREFIX_DIR}/lib"
        "LINKER:-rpath,$ORIGIN")
  endif()
endmacro()

macro(_robot_bus_map_release_configs _robot_bus_rpath_target)
  set_target_properties(${_robot_bus_rpath_target} PROPERTIES
    MAP_IMPORTED_CONFIG_DEBUG Release
    MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
    MAP_IMPORTED_CONFIG_MINSIZEREL Release)
endmacro()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/robot_busTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/robot_busTargets.cmake")
endif()

if(NOT TARGET robot_bus::robot_bus)
  add_library(robot_bus::robot_bus SHARED IMPORTED GLOBAL)
  set_target_properties(robot_bus::robot_bus PROPERTIES
    INTERFACE_COMPILE_FEATURES cxx_std_17
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  if(WIN32)
    set_target_properties(robot_bus::robot_bus PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/robot_bus_c.dll"
      IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/robot_bus.lib")
  elseif(APPLE)
    set_target_properties(robot_bus::robot_bus PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/librobot_bus.dylib")
  else()
    set_target_properties(robot_bus::robot_bus PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/librobot_bus.so")
  endif()
  _robot_bus_map_release_configs(robot_bus::robot_bus)
  _robot_bus_add_consumer_rpath(robot_bus::robot_bus)
endif()

# Packaged installs copy librobot_bus_msgs but may not ship an EXPORT file;
# always expose robot_bus::msgs so consumers can link typed protobuf stubs.
if(NOT TARGET robot_bus::msgs)
  add_library(robot_bus::msgs SHARED IMPORTED GLOBAL)
  set_target_properties(robot_bus::msgs PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    INTERFACE_LINK_LIBRARIES "protobuf::libprotobuf")
  if(WIN32)
    set_target_properties(robot_bus::msgs PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/robot_bus_msgs.dll"
      IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/robot_bus_msgs.lib")
  elseif(APPLE)
    set_target_properties(robot_bus::msgs PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/librobot_bus_msgs.dylib")
  else()
    set_target_properties(robot_bus::msgs PROPERTIES
      IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/librobot_bus_msgs.so")
  endif()
  _robot_bus_map_release_configs(robot_bus::msgs)
  _robot_bus_add_consumer_rpath(robot_bus::msgs)
endif()

if(WIN32)
  set(_robot_bus_ros2_lib "")
elseif(APPLE)
  set(_robot_bus_ros2_lib "${PACKAGE_PREFIX_DIR}/lib/librobot_bus_ros2_bridge.dylib")
else()
  set(_robot_bus_ros2_lib "${PACKAGE_PREFIX_DIR}/lib/librobot_bus_ros2_bridge.so")
endif()
if(_robot_bus_ros2_lib AND EXISTS "${_robot_bus_ros2_lib}" AND NOT TARGET robot_bus::ros2_bridge)
  if(UNIX AND DEFINED ENV{AMENT_PREFIX_PATH})
    string(REPLACE ":" ";" _robot_bus_ament_prefixes "$ENV{AMENT_PREFIX_PATH}")
    list(APPEND CMAKE_PREFIX_PATH ${_robot_bus_ament_prefixes})
    unset(_robot_bus_ament_prefixes)
  endif()
  find_dependency(rclcpp)
  find_dependency(rclcpp_action)
  foreach(_robot_bus_ros2_pkg IN ITEMS
      std_msgs sensor_msgs geometry_msgs nav_msgs std_srvs example_interfaces
      builtin_interfaces action_msgs diagnostic_msgs shape_msgs stereo_msgs
      tf2_msgs trajectory_msgs unique_identifier_msgs visualization_msgs)
    find_dependency(${_robot_bus_ros2_pkg})
  endforeach()
  set(PACKAGE_PREFIX_DIR "${_robot_bus_package_prefix}")

  add_library(robot_bus::ros2_bridge SHARED IMPORTED GLOBAL)
  set_target_properties(robot_bus::ros2_bridge PROPERTIES
    IMPORTED_LOCATION "${_robot_bus_ros2_lib}"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
    INTERFACE_COMPILE_DEFINITIONS "ROBOT_BUS_HAS_ROS2")
  _robot_bus_map_release_configs(robot_bus::ros2_bridge)

  set(_robot_bus_ros2_deps robot_bus::robot_bus robot_bus::msgs rclcpp::rclcpp rclcpp_action::rclcpp_action)
  foreach(_robot_bus_ros2_pkg IN ITEMS
      std_msgs sensor_msgs geometry_msgs nav_msgs std_srvs example_interfaces
      builtin_interfaces action_msgs diagnostic_msgs shape_msgs stereo_msgs
      tf2_msgs trajectory_msgs unique_identifier_msgs visualization_msgs)
    if(TARGET ${_robot_bus_ros2_pkg}::${_robot_bus_ros2_pkg})
      list(APPEND _robot_bus_ros2_deps ${_robot_bus_ros2_pkg}::${_robot_bus_ros2_pkg})
    endif()
    if(DEFINED ${_robot_bus_ros2_pkg}_TARGETS)
      list(APPEND _robot_bus_ros2_deps ${${_robot_bus_ros2_pkg}_TARGETS})
    endif()
  endforeach()
  set_target_properties(robot_bus::ros2_bridge PROPERTIES
    INTERFACE_LINK_LIBRARIES "${_robot_bus_ros2_deps}")
  _robot_bus_add_consumer_rpath(robot_bus::ros2_bridge)
endif()

set(CMAKE_PREFIX_PATH "${_robot_bus_saved_prefix_path}")
unset(_robot_bus_saved_prefix_path)
unset(_robot_bus_package_prefix)
check_required_components(robot_bus)
